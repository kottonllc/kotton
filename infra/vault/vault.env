# /etc/kotton/vault.env: what the vault is told, read by kotton-vault.service.
#
# install.sh writes this file once, with these defaults, and never overwrites it:
# edit it here, then `systemctl restart kotton-vault`. It is root's and the group
# kotton-vault's, mode 0640, and nobody else's, because the KVAULTD_S3_* keys below
# are a secret when you use a bucket: systemd reads it as root and hands every value
# to the vault's user, which may read the file for the same reason.
#
# Keep it in the plain form: every line blank, a comment (# or ; first), or
# KEY=value, KEY="value" or KEY='value' at the start of the line, no space around
# = or after the value, printable ASCII with no quote or backslash in the value; no
# line ending in a backslash; no carriage return and no NUL anywhere. It has three
# readers and all three read only that: systemd's EnvironmentFile=, install.sh,
# which refuses a file with any other line, and `kvaultd invite` and the other
# verbs typed at the host's shell, which read this file beside the binary install.sh
# placed, so they find the running vault where this file told it to make its door.

# **The host's one address**, the one value a person must set: what a device
# dials, what the vault announces in the ceremony, and where its owner's desktop
# reaches it first. `KOTTON_PUBLIC_ADDR=<ip> sh install.sh` on the first install
# writes it (TASK-a-box-has-one-public-address).
#
# No relay is named here, and no key of anyone's
# (TASK-the-desktop-tells-the-vault-which-relays-to-stand-at, RFC-0084 V12): a
# vault stands where its owner's desktop tells it — its `enrol` does — and keeps
# that in its own state under KOTTON_BASE_DIR. A `KOTTON_RELAY_URL=` line left by
# an install before 2026-09-29 is not read, and can be deleted.
KOTTON_PUBLIC_ADDR=

# Everything the vault keeps. systemd makes this directory (StateDirectory=).
KOTTON_BASE_DIR=/var/lib/kotton-vault

# Where a person's devices reach it: 7710/udp, the port table's (infra/README.md).
KOTTON_PEER_LISTEN_PORT=7710

# The one meter: bytes each pool may hold. 0 is no quota.
KVAULTD_QUOTA_BYTES=0

# Where the pools rest: `local` (KOTTON_BASE_DIR) or `s3`, a bucket named by the
# KVAULTD_S3_* variables (infra/vault/README.md).
KVAULTD_SHELF=local
KVAULTD_S3_ENDPOINT=
KVAULTD_S3_BUCKET=
KVAULTD_S3_REGION=us-east-1
KVAULTD_S3_PREFIX=
KVAULTD_S3_ACCESS_KEY=
KVAULTD_S3_SECRET_KEY=

RUST_LOG=info
# Plain text in the journal, not terminal colours.
NO_COLOR=1

# What the vault's image set for it, carried: a host has no keychain and says so
# (KOTTON_SECRETS=file keeps the vault's host key in a 0600 file under
# KOTTON_BASE_DIR); the door's name; and the directory its socket is made in,
# which kotton-vault.service creates (RuntimeDirectory=).
KOTTON_SECRETS=file
KVAULTD_IPC_NAME=vault
XDG_RUNTIME_DIR=/run/kotton-vault
