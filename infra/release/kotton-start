#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Start Kotton: the daemon, which starts everything else it needs from beside
# itself. It runs in this terminal; leave it running (Ctrl-C stops it) and type
# the rest in another terminal.
#
# Make your identity from another terminal with `kotton id create <name>`.
#
#   kotton-start
#   RUST_LOG=info kotton-start       say more about what it is doing
#
# Written for `cargo xtask release` (TASK-a-friend-cannot-install-kotton-without-a-toolchain).
set -eu

self=$(readlink -f -- "$0" 2>/dev/null || printf '%s\n' "$0")
here=$(CDPATH='' cd -- "$(dirname -- "$self")" && pwd)

RUST_LOG=${RUST_LOG:-warn}
export RUST_LOG
exec "$here/bin/kuserd"
