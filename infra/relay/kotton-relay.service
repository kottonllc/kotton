# The relay, run by systemd on a host (DEC-0085). `install.sh` places this file
# in /etc/systemd/system; `systemctl enable --now kotton-relay` starts it now and
# at every boot. What it runs is /usr/local/bin/kotton-relay, the one binary the
# archive carries, and what it is told is /etc/kotton/relay.env, which a person
# edits and a later install never overwrites.
#
# It runs as kotton-relay, a system user of its own that install.sh makes when
# the host has none, and holds no more of the host than that user does: it reads
# bytes a stranger wrote, so it does not do it as root
# (TASK-the-relay-and-the-vault-run-as-root-on-a-box). systemd makes its state
# directory owned by that user and, by its documentation (not yet run), hands one
# an older release left root's to that user at the next start. The operator verbs
# write that directory as its owner — typed as root, a verb runs itself again as that
# user and opens nothing there as root — so at the host's shell they are typed as root
# or as the same user, and the relay reads the file either way
# (TASK-a-relay-operator-verb-typed-as-root-reads-operators-by-a-path-the-relays-user-controls):
#
#   kotton-relay --state-dir /var/lib/kotton-relay operator enrol <key>
#   runuser -u kotton-relay -- kotton-relay --state-dir /var/lib/kotton-relay operator enrol <key>

[Unit]
Description=Kotton relay: address exchange and blind circuits; it carries and keeps nothing
Documentation=https://github.com/kottonllc/kotton/blob/main/docs/use/run-a-relay.md
Wants=network-online.target
After=network-online.target

[Service]
User=kotton-relay
Group=kotton-relay
EnvironmentFile=/etc/kotton/relay.env
ExecStart=/usr/local/bin/kotton-relay
Restart=on-failure
RestartSec=5
StateDirectory=kotton-relay
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
# What the binary never reaches for, taken away
# (TASK-the-relay-and-the-vault-units-are-still-rated-exposed). Run under systemd
# 255 on Ubuntu 24.04 with it answering /health; traced there, it opens AF_INET
# sockets and nothing else — no AF_NETLINK, since it lists no interfaces; AF_INET6
# stays for a KOTTON_RELAY_BIND a person sets to a v6 address. A call
# outside the filter fails with EPERM rather than killing the process, so one
# path nobody traced fails in its own log line instead of taking every
# connection down with it. Empty CapabilityBoundingSet= is the bounding set
# only: a non-root service under NoNewPrivileges= holds no capability anyway.
CapabilityBoundingSet=
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# The rest systemd-analyze counts, each one line for a binary that never reaches
# for it (TASK-the-relay-and-the-vault-units-leave-ten-directives-unset-that-nobody-has-run).
# Traced outside systemd while it answered /health, it made no SysV or POSIX
# IPC object and no writable and executable mapping, asked for no realtime
# scheduling, and read no /proc file but its own. PrivateUsers= maps only root
# and this unit's user; nothing the relay reads is another user's, and its
# operator verbs run at the host's shell, outside the unit.
# None of these six has run under systemd yet: a host that will not start with
# one names it in the journal. Why RootDirectory=, PrivateNetwork=,
# IPAddressDeny= and DeviceAllow= are not set is in that record.
RemoveIPC=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
ProtectProc=invisible
ProcSubset=pid
PrivateUsers=yes

[Install]
WantedBy=multi-user.target
