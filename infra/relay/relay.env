# /etc/kotton/relay.env: what the relay is told, read by kotton-relay.service.
#
# install.sh writes this file once, with these defaults, and never overwrites it:
# edit it here, then `systemctl restart kotton-relay`. A later release that adds
# a variable says so in its notes; the file on the host keeps what you set.
#
# One `KEY=value` a line, as systemd's EnvironmentFile= reads it: no `export`,
# no `${…}`. The same file, sourced in a subshell, is what the relay's operator
# verbs at the host's shell need (infra/relay/README.md, "The verbs at the host").

# Where the relay listens: 7700/tcp, the port table's (infra/README.md).
KOTTON_RELAY_BIND=0.0.0.0:7700

# The address the relay announces about itself: signed into its answer at
# GET /identity, and the hint its line carries, so a desktop that pastes the
# line knows where to dial. install.sh writes http://<the host's address>:<the
# port KOTTON_RELAY_BIND names> here when it is given the address
# (KOTTON_PUBLIC_ADDR) or a yes to the one the ssh session arrived at, and only
# while this is empty.
#
# Keep this file in the plain form: every line blank, a comment (# or ; first),
# or KEY=value, KEY="value" or KEY='value' at the start of the line, no space
# around = or after the value, printable ASCII with no quote or backslash in the
# value; no line ending in a backslash; no carriage return and no NUL anywhere.
# install.sh reads it only so, and refuses a file with any other line, since
# each changes what systemd reads of the rest.
KOTTON_RELAY_ADVERTISE=

# Its STUN responder. The compose file never published it, so no host ever
# answered on 7700/udp; bound to loopback, none still does. Opening it is a
# row in the port table first.
KOTTON_RELAY_STUN_BIND=127.0.0.1:7700

# Seconds a stored address entry lives.
KOTTON_RELAY_TTL=60

# The relay's one rule and the operators who may set it: its own configuration
# and none of what it carries. systemd makes this directory (StateDirectory=).
KOTTON_RELAY_STATE_DIR=/var/lib/kotton-relay

RUST_LOG=info
# Plain text in the journal, not terminal colours.
NO_COLOR=1
