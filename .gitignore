/.env
# Every build output: the workspace target, xtask's, each guest app's, the relay's and the
# release archives, one directory to delete and one to `du` (`.cargo/config.toml`,
# `xtask/src/out.rs`, `just clean`).
/out/
# `/out/` is anchored at the root, so a cargo command run from inside xtask/ with the alias's
# relative `--target-dir out/xtask` writes xtask/out/ instead, and nothing ignored it: one such
# run once put about 300 MB of build output into a commit. Ignored by name, beside the rule it
# slipped past.
xtask/out/
/target/
# The `cargo xtask` aliases built into `target-xtask` from 2026-09-18 until 2026-09-26,
# when every output moved under `out/` (above); the patterns stay for a checkout that
# still holds those trees. The pattern above matches a directory named exactly
# `target`, so it did not cover `target-xtask` — 742 files and 123 MB of build output
# reached `main` on 2026-09-16 before anyone noticed. Ignore the shape, not the name.
target-*/

# Agent worktrees (`git worktree add .claude/worktrees/<branch>` — see AGENTS.md,
# "Working in parallel"). Created and removed per unit of work, each carrying its own
# target/. Never committed: a linked worktree holds a .git file, so `git add` on one
# records a bogus gitlink rather than the files. `.claude/skills/` stays tracked.
/.claude/worktrees/

# App WASM build artifacts (built by CI / `just build::all`)
# Leading-slash-free and un-anchored: a pattern containing a slash is anchored to
# this file's directory, so `apps/**/app.wasm` stopped matching when the apps moved
# to `guest/apps/` and two build artifacts started showing up as
# untracked. `**/app.wasm` matches at any depth, wherever a region puts them next.
**/app.wasm
# The browser's half of the pairing ceremony, built in the reference; this repository does not build it.
/client/web/assets/pair.wasm
# Staged from ui/tokens.css by the reference's web build, which is not here. The phone
# is served from a directory and cannot include_str! the way the shell does.
/client/web/assets/tokens.css
/node_modules/
# Archives made by `just release::desktop` and `cargo xtask release-server` lived here
# until 2026-09-26 and are under `out/dist/` now; the line stays for a checkout that still
# holds one.
/dist/
# Rust
/target/
**/*.rs.bk
*.pdb
target/

# Local dev data (created by `just daemon` / KOTTON_BASE_DIR=.kotton.dev)
/.kotton.dev/
# Wiped and recreated by `just desktop::first-run` on every invocation.
/.kotton.firstrun/
# Same, created by test runs anywhere in the tree (e.g. tests/.kotton.dev/)
**/.kotton.dev/
# Any local KOTTON_BASE_DIR data dir (nodes harness .kotton.node-a/-b, ad-hoc
# .kotton.pc-test, etc.) — all runtime data, never committed.
/.kotton.*/

# VHS installer archives (download to /tmp, install to ~/.local/bin instead)
vhs_*
# Demo runtime data (created by `just demo::sync`)
/.kotton.demo/

# Environment files (contain secrets)
.env
.env.local
.env.*.local
.env.old
server/.env
server/.env.test
client/.env

# Keep example files
!.env.example
!server/.env.example
!server/.env.test.example
!client/.env.example

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Database
*.db
*.sqlite


# Dev dashboard logs
logs/
*.log

# Keep sqlx offline query metadata
!.sqlx/

# node_modules
node_modules/

# Frontend build output
dist/

# Generated by @kotton/vite-plugin — recreated on every build
kotton.generated.d.ts

# Astro generated type files
.astro/

relay-inbox*

# Agent scratch: cargo diagnostics captured for scripted fixes. Never committed.
kerr.txt


# `cargo run --bin gallery --features gallery` writes the rendered specimen pages
# to the repo root. They are a build artifact of the component tree — regenerating
# them is one command — and committing them would put a 677KB copy of every screen
# under review on every commit that moves a pixel.
/gallery/

# Binaries handed to `infra/Dockerfile` (ARTIFACTS=prebuilt) by `just stack::prebuilt`
infra/prebuilt/*
!infra/prebuilt/.gitkeep

# What the deleted `just box::` recipes wrote: a box's env file and
# its operator credential, a secret key. Nothing writes them now; the ignore
# stays so a laptop that still holds one never commits it.
infra/box/*.env
infra/box/*.operator
infra/box/*.operator.tmp
